{
  "info": {
    "name": "EventFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "event_id", "value": "" },
    { "key": "category_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@test.com\",\n  \"password\": \"test1234\",\n  \"full_name\": \"Jean Organisateur\",\n  \"role\": \"organizer\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@test.com\",\n  \"password\": \"test1234\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Published Events",
          "request": { "method": "GET", "url": "{{base_url}}/events" }
        },
        {
          "name": "Get Event Detail",
          "request": { "method": "GET", "url": "{{base_url}}/events/{{event_id}}" }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Concert de rentrée\",\n  \"description\": \"Un super concert\",\n  \"location\": \"Antananarivo\",\n  \"start_date\": \"2026-09-15T18:00:00Z\",\n  \"end_date\": \"2026-09-15T23:00:00Z\"\n}"
            },
            "url": "{{base_url}}/events"
          }
        },
        {
          "name": "Add Ticket Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Standard\",\n  \"price\": 15000,\n  \"quantity_total\": 100\n}"
            },
            "url": "{{base_url}}/events/{{event_id}}/categories"
          }
        },
        {
          "name": "Publish Event",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/events/{{event_id}}/publish"
          }
        },
        {
          "name": "Event Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/events/{{event_id}}/stats"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{category_id}}\"\n}"
            },
            "url": "{{base_url}}/payments/checkout"
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "My Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/tickets/my"
          }
        }
      ]
    },
    {
      "name": "Checkins",
      "item": [
        {
          "name": "Scan Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_code\": \"COLLE_LE_CODE_QR_ICI\"\n}"
            },
            "url": "{{base_url}}/checkins"
          }
        }
      ]
    }
  ]
}